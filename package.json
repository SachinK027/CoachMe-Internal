{
  "name": "coachme",
  "version": "1.0.0",
  "private": true,
  "description": "CoachME Advisory – public website, admin CMS, and API monorepo",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:api": "pnpm --filter api start:dev",
    "build:content": "pnpm --filter @coachme/content build",
    "build": "pnpm build:content && pnpm -r --filter '!@coachme/content' build",
    "build:web": "pnpm --filter web build",
    "build:admin": "pnpm --filter admin build",
    "build:api": "pnpm --filter api build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "typescript": "^5"
  }
}
